<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="main.css">
  <title>Log In</title>
</head>

<body>
  <h1>Join the club</h1>
  <p>Get exclusive access to see who wrote messages and when they were posted!</p>
  <form action="/join-club" method="POST">
    <ul>
      <li>
        <label for="password">Club password</label>
        <input type="text" name="password" id="password">
      </li>
    </ul>
    <button type="submit">Join</button>
  </form>
</body>

</html>